{
  "name": "smart-tv-desktop-remote",
  "version": "0.3.0",
  "description": "Windows desktop remote for smart TVs on your local network: LG webOS, Samsung Tizen, Android TV / Google TV, Roku, Vizio SmartCast and Sony BRAVIA",
  "main": "src/main/main.js",
  "private": true,
  "author": "dor2500",
  "scripts": {
    "start": "electron .",
    "start:fake": "node tests/run-with-fake-tv.js",
    "test": "node --test tests/webos.test.js tests/brands.test.js tests/anywhere.test.js",
    "test:e2e": "node tests/e2e.js",
    "test:brands": "node tests/e2e-brands.js",
    "test:anywhere": "node anywhere/build.js && node tests/e2e-anywhere.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "selfsigned": "^2.4.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.1"
  },
  "build": {
    "appId": "com.dor2500.smarttvdesktopremote",
    "productName": "Smart TV Desktop Remote",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
